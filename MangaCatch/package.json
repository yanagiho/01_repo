{
  "name": "mangacatch",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:chromebook": "concurrently \"vite --config vite.web.config.ts\" \"node osc-bridge.mjs\"",
    "build:web": "tsc -b && vite build",
    "dist": "npm run build:web && electron-builder",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:win": "npm run build:web && electron-packager . MangaCatch --platform=win32 --arch=x64 --out=release/packager --overwrite --electron-version=33.4.11 --ignore=\"^/src$|^/electron$|^/\\.git|^/release$|^/node_modules$|^/pnpm-lock\\.yaml$|^/DEBUG_SENSOR_TASK\\.md$|^/README\\.md$|^/eslint\\.config\\.js$|^/tsconfig|^/vite\\.config|^/index\\.html$|^/public$\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "node-osc": "^11.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^25.2.0",
    "@types/node-osc": "^9.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^29.4.6",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^9.0.3",
    "ws": "^8.19.0"
  },
  "build": {
    "appId": "com.gade.mangacatch",
    "productName": "MangaCatch",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
